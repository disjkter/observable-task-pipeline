# Copy this file to .env and replace the placeholders with local values.
# Never commit the real .env file.
DATABASE_URL=postgresql+psycopg://pipeline_user:change-me@localhost:5432/observable_pipeline
ARTIFACT_BACKEND=local
ARTIFACT_ROOT=./artifacts
# S3/MinIO mode: install with `pip install -e ".[s3]"`, set ARTIFACT_BACKEND=s3,
# and configure the following values. Leave credentials empty to use the standard AWS chain.
ARTIFACT_S3_BUCKET=
ARTIFACT_S3_PREFIX=observable-task-pipeline
ARTIFACT_S3_ENDPOINT_URL=
ARTIFACT_S3_REGION=
ARTIFACT_S3_ACCESS_KEY_ID=
ARTIFACT_S3_SECRET_ACCESS_KEY=
LOG_LEVEL=INFO
LEASE_SECONDS=10
POLL_INTERVAL_SECONDS=0.2
WORKER_IDLE_BACKOFF_MAX_SECONDS=5
WORKER_IDLE_BACKOFF_MULTIPLIER=2
TASK_NOTIFY_ENABLED=true
TASK_NOTIFY_CHANNEL=pipeline_task_ready
RETRY_BASE_SECONDS=0.1
RETRY_MAX_SECONDS=2
GPU_TOTAL_MEMORY_MB=8192
